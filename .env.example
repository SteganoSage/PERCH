# PERCH — local defaults. Nothing sensitive lives here; the whole stack is localhost-only.
# Ports are deliberately off the common defaults to avoid clashes (see CLAUDE.md §6).

# ---- Host port mappings ----
PROXY_PORT=8080
STABLE_PORT=8091
CANARY_PORT=8092
PROMETHEUS_PORT=9095
GRAFANA_PORT=3005

# ---- Stable service (never faulted) ----
STABLE_ERROR_RATE=0.0
STABLE_LATENCY_MS_MEAN=40
STABLE_LATENCY_MS_JITTER=10

# ---- Canary service (scenario scripts overwrite these) ----
CANARY_ERROR_RATE=0.0
CANARY_LATENCY_MS_MEAN=40
CANARY_LATENCY_MS_JITTER=10
CANARY_DEGRADE_ENDPOINT=
CANARY_DEGRADE_RAMP_SECONDS=

# ---- Controller ----
# Decision mode: tier1 (statistical), naive_threshold (baseline), tier2_sprt (advanced)
DECISION_MODE=tier1
POLL_INTERVAL_SECONDS=5
PROMETHEUS_URL=http://prometheus:9090
RAMP_BAKE_SECONDS=25
RAMP_STAGES=5,10,25,50,100
MIN_SAMPLES_PER_WINDOW=40
LATENCY_TOLERANCE=1.5
DECISION_ALPHA=0.05
DECISION_BETA=0.10
PROXY_CONTAINER=perch-proxy
TEMPLATE_PATH=/app/nginx.conf.j2
NGINX_CONF_PATH=/etc/nginx/conf.d/default.conf
DECISION_LOG_PATH=/results/decision_log.jsonl
PROXY_RELOAD_DEBOUNCE_SECONDS=2
ROLLBACK_IS_TERMINAL=true

# ---- Load generator ----
LOADGEN_TARGET=http://localhost:8080
LOADGEN_RPS=50
LOADGEN_DURATION=0
LOADGEN_MIX=work:2,work/checkout:1
LOADGEN_OUTPUT=/results/loadgen.jsonl
