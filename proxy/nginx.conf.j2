# Live traffic split. Rendered by the controller on every weight change.
#
# nginx rejects weight=0, so a zero-weight peer is marked `down` instead of
# `weight=0`. The controller's template context always supplies integers.

upstream backend {
    {% if stable_weight > 0 -%}
    server stable:8000 weight={{ stable_weight }};
    {% else -%}
    server stable:8000 down;
    {% endif -%}
    {% if canary_weight > 0 -%}
    server canary:8000 weight={{ canary_weight }};
    {% else -%}
    server canary:8000 down;
    {% endif %}
}

server {
    listen 80;

    location / {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Surface which backend served the request so blast radius can be
        # counted from the load generator as well as from Prometheus.
        add_header X-Upstream $upstream_addr always;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
    }
}
