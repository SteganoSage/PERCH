# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Run artifacts. Each scripted run is archived to results/archive/<scenario>_<stamp>/ and
# committed as evidence; the live files the containers write mid-run are scratch, and so are
# logs from controllers started outside the runner (unscripted_*).
results/*
!results/.gitkeep
!results/archive/
!results/campaigns/
!results/experiments/
results/archive/unscripted_*/

# Rendered proxy config (generated at runtime from nginx.conf.j2)
proxy/nginx.conf

# Bind-mount directory for live nginx config (written by controller at runtime)
proxy-conf/*
!proxy-conf/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store

implementation-plans/

CLAUDE.md

.env

# Personal study notes
docs/study-plan.md
